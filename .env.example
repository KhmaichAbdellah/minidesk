# ═══════════════════════════════════════════════════════════════════════════════
# .env.example — Variables d'environnement MiniDesk
# ═══════════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS :
#   1. Copier ce fichier : cp .env.example .env
#   2. Remplir les vraies valeurs dans .env
#   3. Ne JAMAIS commiter .env dans Git (déjà dans .gitignore)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Base de données PostgreSQL ───────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── JWT ──────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 64
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_64_CHARS
JWT_EXPIRATION=86400000

# ── Email SMTP (Gmail App Password) ─────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# ── Admin par défaut ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@minidesk.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── LLM (Intelligence Artificielle) ──────────────────────────────────────────
# Provider : 'openai' (recommandé en prod) ou 'ollama' (local dev)
LLM_PROVIDER=openai
LLM_MOCK=false

# Clé API OpenAI (obtenue sur https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-votre-cle-api-openai-ici
OPENAI_MODEL=gpt-4o-mini

# Configuration Ollama (uniquement si LLM_PROVIDER=ollama en local)
OLLAMA_ENDPOINT=http://localhost:11434/api/chat
OLLAMA_MODEL=phi3:mini

# ── Frontend ─────────────────────────────────────────────────────────────────
# En production : URL publique de votre backend
VITE_API_URL=http://your-domain.com:8081

# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── GitLab Registry ──────────────────────────────────────────────────────────
REGISTRY_URL=registry.gitlab.com
GITLAB_GROUP=KhmaichAbdellah
GITLAB_PROJECT=minidesk
IMAGE_TAG=latest
